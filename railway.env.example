# Cole no Railway: serviço web -> Variables -> "Raw Editor". Preencha os campos vazios.
# Não coloque valores reais neste arquivo nem faça commit de um .env com segredos.

# Banco: referencia o plugin PostgreSQL do projeto (troque "Postgres" se o serviço tiver outro nome)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Com DEBUG=false o servidor NÃO INICIA se SECRET_KEY ou ADMIN_PASSWORD estiverem ausentes ou fracas.
DEBUG=false
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Login em /admin. Senha: mínimo 12 caracteres, com letras e números/símbolos.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Opcional: se preenchida, quem só quer VER as notas também precisa dessa senha (mínimo 8 caracteres).
# Recomendado: os PDFs trazem CNPJ/CPF, valores e, às vezes, dados bancários do fornecedor.
VIEWER_PASSWORD=

# Opcional: criptografa os PDFs gravados no banco. Gere com:
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# GUARDE essa chave num cofre: sem ela os PDFs já gravados ficam ilegíveis.
DOCUMENT_ENCRYPTION_KEY=

# Limites
MAX_UPLOAD_MB=10
MAX_FILES_PER_UPLOAD=20
# O Railway coloca 1 proxy na frente do app (usado para ler o IP real na trava de tentativas de login)
TRUSTED_PROXY_COUNT=1

# Proteção e desempenho do "Baixar tudo em PDF" (valores padrão; só mexa se precisar)
MAX_MERGED_PAGES=2500
MERGE_CONCURRENCY=2
MERGE_RATE_PER_MINUTE=6
MERGE_CACHE_MB=64
